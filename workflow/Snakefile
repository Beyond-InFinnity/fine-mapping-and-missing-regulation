# -------------------------------------------------------------- aggregation
def stage1_coloc_files(wildcards):
    files = []
    for locus in analysed_loci():
        for ds in STAGE1_ALL:
            files.append(f"{RES}/coloc/{ds}/{locus}.tsv")
    return files


rule aggregate:
    input:
        coloc=stage1_coloc_files,
        loci=f"{DATA}/derived/loci_hg38.tsv",
        datasets=config["datasets_tsv"],
    output:
        gene_level=f"{RES}/stage1/coloc_gene_level.tsv.gz",
        per_locus=f"{RES}/stage1/per_locus_table.tsv",
        summary=f"{RES}/stage1/summary.json",
    params:
        thr=config["coloc"]["pp4_threshold"],
        locus_filter=lambda wc: ",".join(config["locus_filter"] or []),
        coloc_dir=f"{RES}/coloc",
    shell:
        "python scripts/aggregate_stage1.py --loci {input.loci} "
        "--datasets {input.datasets} --coloc-dir {params.coloc_dir} "
        "--locus-filter '{params.locus_filter}' --pp4-threshold {params.thr} "
        f"--gtex-cortex-id {GTEX_CORTEX_ID} --metabrain-id {METABRAIN_ID} "
        "--out-gene-level {output.gene_level} "
        "--out-per-locus {output.per_locus} --out-summary {output.summary}"
