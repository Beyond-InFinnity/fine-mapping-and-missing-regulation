# ============================================================================
# Stage 1 — SCZ GWAS x brain eQTL colocalization baseline
# Run from the repository root:  snakemake -s workflow/Snakefile --cores N \
#     --resources net=8
# ============================================================================
import csv
import os

configfile: "config/config.yaml"

DATA = config["paths"]["data"]
RES = config["paths"]["results"]
UA = ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
      "(KHTML, like Gecko) Chrome/120.0 Safari/537.36")


def load_datasets():
    with open(config["datasets_tsv"]) as f:
        rows = list(csv.DictReader(
            (ln for ln in f if not ln.startswith("#")), delimiter="\t"))
    return {r["dataset_id"]: r for r in rows}


DATASETS = load_datasets()
STAGE1_EQC = [d for d, r in DATASETS.items()
              if r["stage"] == "1" and r["source_type"] == "eqtl_catalogue"]
STAGE1_ALL = STAGE1_EQC + [d for d, r in DATASETS.items()
                           if r["stage"] == "1" and r["source_type"] == "metabrain"]
METABRAIN_ID = "MetaBrain_Cortex_EUR"
GTEX_CORTEX_ID = "QTD000171"

_LOCI_CACHE = {}


def loci_rows(path):
    """Read the loci table (input functions run after the checkpoint)."""
    if path not in _LOCI_CACHE:
        with open(path) as f:
            _LOCI_CACHE[path] = {r["locus_id"]: r
                                 for r in csv.DictReader(f, delimiter="\t")}
    return _LOCI_CACHE[path]


def analysed_loci():
    path = checkpoints.loci_hg38.get().output[0]
    rows = loci_rows(path)
    ids = [l for l, r in rows.items() if r["status"] == "pass"]
    if config["locus_filter"]:
        keep = set(config["locus_filter"])
        unknown = keep - set(ids)
        assert not unknown, f"locus_filter ids not found among pass loci: {unknown}"
        ids = [l for l in ids if l in keep]
    return ids


def locus_field(locus, field):
    path = checkpoints.loci_hg38.get().output[0]
    return loci_rows(path)[locus][field]


wildcard_constraints:
    locus=r"[0-9]+-[A-Za-z0-9\-]+",
    chrom=r"[0-9]+",


rule all:
    input:
        f"{RES}/stage1/per_locus_table.tsv",
        f"{RES}/stage1/summary.json",
        f"{RES}/stage1/fig_stage1.png",


