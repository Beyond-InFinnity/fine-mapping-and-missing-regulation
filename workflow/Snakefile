# ------------------------------------------------------------ harmonization
rule harmonize_gwas:
    input:
        raw=f"{DATA}/raw/gwas/pgc3_scz_primary_autosome.tsv.gz",
        chain=f"{DATA}/raw/liftover/hg19ToHg38.over.chain.gz",
    output:
        hg38=f"{DATA}/derived/gwas/pgc3.hg38.tsv.gz",
        hg38_tbi=f"{DATA}/derived/gwas/pgc3.hg38.tsv.gz.tbi",
        hg19=f"{DATA}/derived/gwas/pgc3.hg19.tsv.gz",
        meta=f"{DATA}/derived/gwas/pgc3.meta.json",
    params:
        cols=",".join(config["gwas"]["expected_columns"]),
        n=config["gwas"]["expected_n_variants"],
        min_lift=config["gwas"]["min_lift_rate"],
        prefix=f"{DATA}/derived/gwas/pgc3",
    threads: 4
    shell:
        "python scripts/harmonize_gwas.py --raw-gz {input.raw} "
        "--chain {input.chain} --expected-columns {params.cols} "
        "--expected-n-variants {params.n} --min-lift-rate {params.min_lift} "
        "--out-prefix {params.prefix} --tmpdir {resources.tmpdir}/pgc3_harmonize"


checkpoint loci_hg38:
    input:
        loci=f"{DATA}/derived/loci_hg19.tsv",
        gwas=f"{DATA}/derived/gwas/pgc3.hg38.tsv.gz",
        chain=f"{DATA}/raw/liftover/hg19ToHg38.over.chain.gz",
    output:
        f"{DATA}/derived/loci_hg38.tsv"
    params:
        window=config["coloc"]["window_bp"]
    shell:
        "python scripts/make_loci_hg38.py --loci {input.loci} "
        "--gwas-hg38 {input.gwas} --chain {input.chain} "
        "--window-bp {params.window} --tmpdir {resources.tmpdir}/loci_hg38 "
        "--out {output}"


# --------------------------------------------------------- region extraction
rule gwas_region:
    input:
        gwas=f"{DATA}/derived/gwas/pgc3.hg38.tsv.gz",
        loci=f"{DATA}/derived/loci_hg38.tsv",
    output:
        f"{DATA}/regions/gwas/{{locus}}.tsv"
    params:
        region=lambda wc: "{}:{}-{}".format(
            locus_field(wc.locus, "chrom"),
            locus_field(wc.locus, "region_start_hg38"),
            locus_field(wc.locus, "region_end_hg38")),
    shell:
        # tabix -h only re-emits '#'-prefixed headers, not lines skipped via
        # -S at index time, so the column header is prepended explicitly
        # (pipefail off: head's early exit sends zcat a benign SIGPIPE)
        r"""
        set +o pipefail
        zcat {input.gwas} | head -1 > {output}
        set -o pipefail
        tabix {input.gwas} {params.region} >> {output}
        """


rule fetch_eqtlcat_region:
    input:
        loci=f"{DATA}/derived/loci_hg38.tsv"
    output:
        f"{DATA}/regions/{{dataset}}/{{locus}}.tsv.gz"
    wildcard_constraints:
        dataset=r"QTD[0-9]+"
    params:
        url=lambda wc: DATASETS[wc.dataset]["sumstats_url"],
        region=lambda wc: "{}:{}-{}".format(
            locus_field(wc.locus, "chrom"),
            locus_field(wc.locus, "region_start_hg38"),
            locus_field(wc.locus, "region_end_hg38")),
        retries=config["network"]["retries"],
    resources:
        net=1
    shell:
        "bash scripts/fetch_eqtl_region.sh '{params.url}' '{params.region}' "
        "{output} {params.retries}"


rule download_metabrain_chr:
    output:
        f"{DATA}/raw/metabrain/{config['metabrain']['file_pattern']}"
    params:
        url=lambda wc: "{}/{}".format(
            config["metabrain"]["base_url"],
            config["metabrain"]["file_pattern"].format(chrom=wc.chrom)),
    resources:
        net=1
    shell:
        r"""
        curl -sSL --retry 3 -C - -o {output} '{params.url}'
        gzip -t {output}
        sha256sum {output} > {output}.sha256
        """


rule metabrain_intervals:
    input:
        loci=f"{DATA}/derived/loci_hg38.tsv"
    output:
        f"{DATA}/derived/metabrain_intervals/chr{{chrom}}.tsv"
    run:
        rows = loci_rows(input.loci)
        wanted = [r for r in rows.values()
                  if r["status"] == "pass" and r["chrom"] == wildcards.chrom]
        with open(output[0], "w") as f:
            for r in wanted:
                f.write(f"{r['locus_id']}\t{r['region_start_hg38']}\t"
                        f"{r['region_end_hg38']}\n")
        assert wanted, f"no pass loci on chr{wildcards.chrom}; " \
            "this rule should not have been requested"


rule extract_metabrain_chr:
    input:
        gz=f"{DATA}/raw/metabrain/{config['metabrain']['file_pattern']}",
        intervals=f"{DATA}/derived/metabrain_intervals/chr{{chrom}}.tsv",
    output:
        flag=touch(f"{DATA}/regions/metabrain/chr{{chrom}}.done")
    params:
        outdir=f"{DATA}/regions/metabrain/chr{{chrom}}",
        expected_header="\t".join(config["metabrain"]["expected_columns"]),
    shell:
        r"""
        mkdir -p {params.outdir}
        set +o pipefail
        obs_header=$(zcat {input.gz} | head -1)
        set -o pipefail
        if [ "$obs_header" != "$(printf '%s' '{params.expected_header}')" ]; then
            echo "FATAL: MetaBrain header mismatch on chr{wildcards.chrom}" >&2
            echo "observed: $obs_header" >&2
            exit 1
        fi
        zcat {input.gz} | awk -v ivf={input.intervals} -v outdir={params.outdir} \
            -f scripts/extract_intervals.awk
        gzip -f {params.outdir}/*.tsv
        """


# -------------------------------------------------------------------- coloc
rule coloc_eqtlcat:
    input:
        gwas=f"{DATA}/regions/gwas/{{locus}}.tsv",
        eqtl=f"{DATA}/regions/{{dataset}}/{{locus}}.tsv.gz",
    output:
        f"{RES}/coloc/{{dataset}}/{{locus}}.tsv"
    wildcard_constraints:
        dataset=r"QTD[0-9]+"
    params:
        n=lambda wc: DATASETS[wc.dataset]["sample_size"],
        p1=config["coloc"]["p1"],
        p2=config["coloc"]["p2"],
        p12=config["coloc"]["p12"],
        min_overlap=config["coloc"]["min_overlap_variants"],
    shell:
        "Rscript scripts/run_coloc.R --gwas-region {input.gwas} "
        "--eqtl-region {input.eqtl} --source-type eqtl_catalogue "
        "--dataset-id {wildcards.dataset} --sample-size {params.n} "
        "--locus-id {wildcards.locus} --p1 {params.p1} --p2 {params.p2} "
        "--p12 {params.p12} --min-overlap {params.min_overlap} --out {output}"


rule coloc_metabrain:
    input:
        gwas=f"{DATA}/regions/gwas/{{locus}}.tsv",
        flag=lambda wc: (f"{DATA}/regions/metabrain/"
                         f"chr{locus_field(wc.locus, 'chrom')}.done"),
    output:
        f"{RES}/coloc/{METABRAIN_ID}/{{locus}}.tsv"
    params:
        eqtl=lambda wc: (f"{DATA}/regions/metabrain/"
                         f"chr{locus_field(wc.locus, 'chrom')}/{wc.locus}.tsv.gz"),
        p1=config["coloc"]["p1"],
        p2=config["coloc"]["p2"],
        p12=config["coloc"]["p12"],
        min_overlap=config["coloc"]["min_overlap_variants"],
    shell:
        "Rscript scripts/run_coloc.R --gwas-region {input.gwas} "
        "--eqtl-region {params.eqtl} --source-type metabrain "
        f"--dataset-id {METABRAIN_ID} --sample-size NA "
        "--locus-id {wildcards.locus} --p1 {params.p1} --p2 {params.p2} "
        "--p12 {params.p12} --min-overlap {params.min_overlap} --out {output}"


