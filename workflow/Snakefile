rule download_chromhmm:
    output:
        f"{DATA}/raw/chromhmm/{{eid}}_15_coreMarks_hg38lift_mnemonics.bed.gz"
    wildcard_constraints:
        eid=r"E[0-9]+"
    params:
        url=lambda wc: config["annotations"]["chromhmm_url_pattern"].format(eid=wc.eid)
    resources:
        net=1
    shell:
        r"""
        curl -sSL --retry 3 -o {output} '{params.url}'
        gzip -t {output}
        """


rule annotate_cs_chromhmm:
    input:
        flag=f"{RES}/stage2/phase2_susie.done",
        loci=f"{DATA}/derived/loci_hg38.tsv",
        fetal=expand(f"{DATA}/raw/chromhmm/{{eid}}_15_coreMarks_hg38lift_mnemonics.bed.gz",
                     eid=config["annotations"]["fetal_eids"]),
        adult=expand(f"{DATA}/raw/chromhmm/{{eid}}_15_coreMarks_hg38lift_mnemonics.bed.gz",
                     eid=config["annotations"]["adult_eids"]),
    output:
        f"{RES}/stage2/cs_chromhmm_annotation.tsv"
    params:
        states=",".join(config["annotations"]["regulatory_states"]),
        susie_dir=f"{RES}/susie",
    shell:
        "python scripts/annotate_cs_chromhmm.py --susie-dir {params.susie_dir} "
        "--loci {input.loci} --fetal-beds {input.fetal} "
        "--adult-beds {input.adult} --states {params.states} --out {output}"


rule aggregate_stage2:
    input:
        phase1=f"{RES}/stage2/phase1_coloc.done",
        phase2=f"{RES}/stage2/phase2_susie.done",
        chromhmm=f"{RES}/stage2/cs_chromhmm_annotation.tsv",
        loci=f"{DATA}/derived/loci_hg38.tsv",
        datasets=config["datasets_tsv"],
        per_locus=f"{RES}/stage1/per_locus_table.tsv",
    output:
        explanations=f"{RES}/stage2/explanations.tsv",
        summary=f"{RES}/stage2/stage2_summary.json",
    params:
        thr=config["coloc"]["pp4_threshold"],
        cs_datasets=",".join(config["coloc_susie"]["datasets"]),
        coloc_dir=f"{RES}/coloc",
        coloc_susie_dir=f"{RES}/coloc_susie",
        susie_dir=f"{RES}/susie",
    shell:
        "python scripts/aggregate_stage2.py --loci {input.loci} "
        "--datasets {input.datasets} --per-locus-stage1 {input.per_locus} "
        "--coloc-dir {params.coloc_dir} "
        "--coloc-susie-dir {params.coloc_susie_dir} "
        "--susie-dir {params.susie_dir} --chromhmm {input.chromhmm} "
        "--coloc-susie-datasets {params.cs_datasets} "
        "--pp4-threshold {params.thr} "
        "--out-explanations {output.explanations} "
        "--out-summary {output.summary}"


