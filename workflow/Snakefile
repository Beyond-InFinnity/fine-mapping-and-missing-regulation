        eur_sensitivity_files
    output:
        touch(f"{RES}/robustness/eur_coloc.done")


# ------------------------- Stage 2 phase 2: LD panel, SuSiE, coloc-SuSiE
rule download_1kg_panel_info:
    output:
        f"{DATA}/raw/ld/integrated_call_samples_v3.20130502.ALL.panel"
    params:
        url=config["ld_panel"]["panel_url"]
    resources:
        net=1
    shell:
        "curl -sSL --retry 3 -o {output} '{params.url}'"


rule eur_sample_ids:
    input:
        f"{DATA}/raw/ld/integrated_call_samples_v3.20130502.ALL.panel"
    output:
        f"{DATA}/derived/ld/eur_ids.txt"
    params:
        n=config["ld_panel"]["expected_n_eur"]
    shell:
        r"""
        awk '$3=="EUR"{{print $1}}' {input} > {output}
        n=$(wc -l < {output})
        if [ "$n" -ne {params.n} ]; then
            echo "FATAL: $n EUR samples, expected {params.n}" >&2; exit 1
        fi
        """


rule download_1kg_chr:
    output:
        temp(f"{DATA}/raw/ld/1kg_chr{{chrom}}.vcf.gz")
    params:
        url=lambda wc: config["ld_panel"]["vcf_url_pattern"].format(chrom=wc.chrom)
    resources:
        net=1
    shell:
        r"""
        curl -sSL --retry 3 -C - -o {output} '{params.url}'
        gzip -t {output}
        """


rule ld_panel_chr:
    input:
        vcf=f"{DATA}/raw/ld/1kg_chr{{chrom}}.vcf.gz",
        eur=f"{DATA}/derived/ld/eur_ids.txt",
    output:
        multiext(f"{DATA}/derived/ld/panel_chr{{chrom}}", ".bed", ".bim", ".fam")
    params:
        maf=config["ld_panel"]["min_maf"],
        prefix=f"{DATA}/derived/ld/panel_chr{{chrom}}",
    threads: 2
    shell:
        "bash scripts/build_ld_panel_chr.sh {input.vcf} {input.eur} "
        "{params.maf} {params.prefix} {resources.tmpdir}/ld_panel"


rule susie_gwas:
    input:
        region=f"{DATA}/regions/gwas/{{locus}}.tsv",
        bed=lambda wc: (f"{DATA}/derived/ld/"
                        f"panel_chr{locus_field(wc.locus, 'chrom')}.bed"),
    output:
        cs=f"{RES}/susie/{{locus}}.cs.tsv",
        lbf=f"{RES}/susie/{{locus}}.lbf.tsv.gz",
        summary=f"{RES}/susie/{{locus}}.summary.json",
    params:
        bfile=lambda wc: (f"{DATA}/derived/ld/"
                          f"panel_chr{locus_field(wc.locus, 'chrom')}"),
        L=config["susie"]["L"],
        coverage=config["susie"]["coverage"],
        prefix=f"{RES}/susie/{{locus}}",
    resources:
        mem_mb=4000
    threads: 2
    shell:
        "Rscript scripts/run_susie_rss.R --gwas-region {input.region} "
        "--bfile {params.bfile} --locus-id {wildcards.locus} "
        "--L {params.L} --coverage {params.coverage} "
        "--out-prefix {params.prefix} --tmpdir {resources.tmpdir}/susie"


rule download_lbf:
    output:
        f"{DATA}/raw/eqtl_lbf/{{dataset}}.lbf_variable.txt.gz"
    wildcard_constraints:
        dataset=r"QTD[0-9]+"
    params:
        url=lambda wc: DATASETS[wc.dataset]["lbf_url"]
    resources:
        net=1
    shell:
        r"""
        curl -sSL --retry 3 -C - -o {output} '{params.url}'
        gzip -t {output}
        """


rule extract_lbf:
    input:
        lbf=f"{DATA}/raw/eqtl_lbf/{{dataset}}.lbf_variable.txt.gz",
        loci=f"{DATA}/derived/loci_hg38.tsv",
    output:
        flag=touch(f"{DATA}/regions_lbf/{{dataset}}.done")
    wildcard_constraints:
        dataset=r"QTD[0-9]+"
    params:
        outdir=f"{DATA}/regions_lbf/{{dataset}}"
    shell:
        "python scripts/extract_lbf.py --lbf {input.lbf} --loci {input.loci} "
        "--outdir {params.outdir}"


rule coloc_susie:
    input:
        lbf=f"{RES}/susie/{{locus}}.lbf.tsv.gz",
        cs=f"{RES}/susie/{{locus}}.cs.tsv",
        flag=f"{DATA}/regions_lbf/{{dataset}}.done",
    output:
        f"{RES}/coloc_susie/{{dataset}}/{{locus}}.tsv"
    wildcard_constraints:
        dataset=r"QTD[0-9]+"
    params:
        eqtl=f"{DATA}/regions_lbf/{{dataset}}/{{locus}}.tsv.gz",
        p1=config["coloc"]["p1"],
        p2=config["coloc"]["p2"],
        p12=config["coloc"]["p12"],
        min_overlap=config["coloc"]["min_overlap_variants"],
    shell:
        "Rscript scripts/run_coloc_susie.R --gwas-lbf {input.lbf} "
        "--gwas-cs {input.cs} --eqtl-lbf {params.eqtl} "
        "--dataset-id {wildcards.dataset} --locus-id {wildcards.locus} "
        "--p1 {params.p1} --p2 {params.p2} --p12 {params.p12} "
        "--min-overlap {params.min_overlap} --out {output}"


def stage2_phase2_files(wildcards):
    loci = analysed_loci()
    files = [f"{RES}/susie/{l}.summary.json" for l in loci]
    for ds in config["coloc_susie"]["datasets"]:
        files += [f"{RES}/coloc_susie/{ds}/{l}.tsv" for l in loci]
    return files


rule stage2_phase2:
    input:
        stage2_phase2_files
    output:
        touch(f"{RES}/stage2/phase2_susie.done")


# --------------------------------- Stage 4: brain meQTL (SMR besd) coloc
rule download_smr:
    output:
        f"{DATA}/tools/smr"
    params:
        url=config["meqtl"]["smr_url"]
    resources:
        net=1
    shell:
        r"""
        curl -sSL --retry 3 -o {resources.tmpdir}/smr.zip '{params.url}'
        unzip -o -q {resources.tmpdir}/smr.zip -d {resources.tmpdir}/smr_extract
        mkdir -p {DATA}/tools
        cp {resources.tmpdir}/smr_extract/smr-*/smr {output}
        chmod +x {output}
        {output} --version 2>&1 | head -2
        """


rule download_brain_mmeta:
    output:
        f"{DATA}/raw/meqtl/Brain-mMeta.tar.gz"
    params:
        url=config["meqtl"]["brain_mmeta_url"]
    resources:
        net=1
    shell:
        r"""
        curl -sSL --retry 3 -C - -o {output} '{params.url}'
        gzip -t {output}
        sha256sum {output} > {output}.sha256
        """


rule extract_brain_mmeta:
    input:
        f"{DATA}/raw/meqtl/Brain-mMeta.tar.gz"
    output:
        multiext(f"{DATA}/derived/meqtl/Brain-mMeta", ".besd", ".esi", ".epi")
    params:
        outdir=f"{DATA}/derived/meqtl"
    shell:
        r"""
        mkdir -p {params.outdir} {resources.tmpdir}/mmeta
        tar xzf {input} -C {resources.tmpdir}/mmeta
        for ext in besd esi epi; do
            src=$(find {resources.tmpdir}/mmeta -name "*.${{ext}}" | head -1)
            if [ -z "$src" ]; then echo "FATAL: no .${{ext}} in archive" >&2; exit 1; fi
            mv "$src" {params.outdir}/Brain-mMeta.${{ext}}
        done
        rm -rf {resources.tmpdir}/mmeta
        """


rule meqtl_region:
    input:
        smr=f"{DATA}/tools/smr",
        besd=f"{DATA}/derived/meqtl/Brain-mMeta.besd",
        loci=f"{DATA}/derived/loci_hg38.tsv",
    output:
        f"{DATA}/regions/meqtl_brain_mmeta/{{locus}}.tsv"
    params:
        prefix=f"{DATA}/derived/meqtl/Brain-mMeta",
        # SMR region filters are hg19 and kb-denominated
        chrom=lambda wc: locus_field(wc.locus, "chrom"),
        from_kb=lambda wc: max(0, (int(locus_field(wc.locus, "index_pos_hg19"))
                                   - config["coloc"]["window_bp"]) // 1000),
        to_kb=lambda wc: (int(locus_field(wc.locus, "index_pos_hg19"))
                          + config["coloc"]["window_bp"]) // 1000 + 1,
    resources:
        mem_mb=3000
    shell:
        "{input.smr} --beqtl-summary {params.prefix} --query 1 "
        "--snp-chr {params.chrom} --from-snp-kb {params.from_kb} "
        "--to-snp-kb {params.to_kb} --out {output}.tmp "
        "&& mv {output}.tmp.txt {output}"


rule coloc_meqtl:
    input:
        gwas=f"{DATA}/regions/gwas/{{locus}}.tsv",
        eqtl=f"{DATA}/regions/meqtl_brain_mmeta/{{locus}}.tsv",
    output:
        f"{RES}/coloc/Brain_mMeta_meQTL/{{locus}}.tsv"
    params:
        n=config["meqtl"]["n_effective"],
        p1=config["coloc"]["p1"],
        p2=config["coloc"]["p2"],
        p12=config["coloc"]["p12"],
        min_overlap=config["coloc"]["min_overlap_variants"],
    shell:
        "Rscript scripts/run_coloc.R --gwas-region {input.gwas} "
        "--eqtl-region {input.eqtl} --source-type smr_meqtl "
        "--dataset-id Brain_mMeta_meQTL --sample-size {params.n} "
        "--locus-id {wildcards.locus} --p1 {params.p1} --p2 {params.p2} "
        "--p12 {params.p12} --min-overlap {params.min_overlap} --out {output}"


def meqtl_coloc_files(wildcards):
    return [f"{RES}/coloc/Brain_mMeta_meQTL/{l}.tsv" for l in analysed_loci()]


rule stage4_meqtl:
    input:
        meqtl_coloc_files
    output:
        touch(f"{RES}/stage4/meqtl_coloc.done")


