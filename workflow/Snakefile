    input:
        per_locus=f"{RES}/stage1/per_locus_table.tsv",
        summary=f"{RES}/stage1/summary.json",
    output:
        png=f"{RES}/stage1/fig_stage1.png",
        pdf=f"{RES}/stage1/fig_stage1.pdf",
    params:
        prefix=f"{RES}/stage1/fig_stage1"
    shell:
        "python scripts/fig_stage1.py --per-locus {input.per_locus} "
        "--summary {input.summary} --out-prefix {params.prefix}"


# ---------------------------------------------------------------- downloads
rule download_supp_zip:
    output:
        f"{DATA}/raw/loci/trubetskoy_supp.zip"
    params:
        url=config["loci"]["supp_zip_url"],
        sha=config["loci"]["supp_zip_sha256"],
    resources:
        net=1
    shell:
        r"""
        curl -sSL -A '{UA}' --retry 3 -o {output} '{params.url}'
        echo '{params.sha}  {output}' | sha256sum -c -
        """


rule extract_table_s3:
    input:
        f"{DATA}/raw/loci/trubetskoy_supp.zip"
    output:
        f"{DATA}/raw/loci/supp_table_3.xls"
    params:
        inner=config["loci"]["table_path_in_zip"]
    shell:
        "unzip -p {input} '{params.inner}' > {output}"


rule parse_loci:
    input:
        f"{DATA}/raw/loci/supp_table_3.xls"
    output:
        f"{DATA}/derived/loci_hg19.tsv"
    params:
        sheet=config["loci"]["sheet_name"],
        n=config["loci"]["expected_n_loci"],
        mhc_chrom=config["loci"]["mhc_chrom"],
        mhc_start=config["loci"]["mhc_start_hg19"],
        mhc_end=config["loci"]["mhc_end_hg19"],
        exclude_mhc=str(config["loci"]["exclude_mhc"]).lower(),
    shell:
        "python scripts/parse_loci.py --xls {input} --sheet '{params.sheet}' "
        "--expected-n-loci {params.n} --mhc-chrom {params.mhc_chrom} "
        "--mhc-start {params.mhc_start} --mhc-end {params.mhc_end} "
        "--exclude-mhc {params.exclude_mhc} --out {output}"


