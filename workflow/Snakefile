        n=lambda wc: DATASETS[wc.dataset]["sample_size"],
        p1=config["coloc"]["p1"],
        p2=config["coloc"]["p2"],
        p12=config["coloc"]["p12"],
        min_overlap=config["coloc"]["min_overlap_variants"],
    shell:
        "Rscript scripts/run_coloc.R --gwas-region {input.gwas} "
        "--eqtl-region {params.eqtl} --source-type bryois "
        "--dataset-id {wildcards.dataset} --sample-size {params.n} "
        "--locus-id {wildcards.locus} --p1 {params.p1} --p2 {params.p2} "
        "--p12 {params.p12} --min-overlap {params.min_overlap} --out {output}"


# ------------------------------------------------- Stage 2 phase 1 targets
def stage2_coloc_files(wildcards):
    ds2 = [d for d, r in DATASETS.items() if r["stage"] == "2"]
    return [f"{RES}/coloc/{d}/{l}.tsv"
            for d in ds2 for l in analysed_loci()]


rule stage2_phase1:
    input:
        stage2_coloc_files
    output:
        touch(f"{RES}/stage2/phase1_coloc.done")


# ------------------------------------------- splicing (sQTL) channel targets
def sqtl_coloc_files(wildcards):
    ds = [d for d, r in DATASETS.items() if r["stage"] == "sqtl"]
    return [f"{RES}/coloc/{d}/{l}.tsv"
            for d in ds for l in analysed_loci()]


rule sqtl_coloc:
    input:
        sqtl_coloc_files
    output:
        touch(f"{RES}/sqtl/coloc.done")


